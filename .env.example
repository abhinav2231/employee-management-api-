# Application Settings
PROJECT_NAME="Aura Workforce OS"
VERSION="1.0.0"
ENV="development"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"

# Auth & Tokens
SECRET_KEY="supersecretkey-for-local-development-change-in-production"
JWT_SECRET="supersecretkey-for-local-development-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Demo Timeline
DEMO_TODAY="2026-09-30"

# Operational & Caching
SEED_ON_START=false
REDIS_URL="redis://localhost:6379/0"
CORS_ORIGINS="*"

# Database Configuration (PostgreSQL)
# Set POSTGRES_SERVER to 'db' when running within Docker Compose.
# Set POSTGRES_SERVER to 'localhost' when running directly on the host machine.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aura_workforce_db

# Complete Database URL (optional override)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/aura_workforce_db
