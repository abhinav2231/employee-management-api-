# Application Settings
PROJECT_NAME="LedgerForge (Aura WorkforceOS)"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-for-local-development-change-in-production"

# Database Configuration (PostgreSQL)
# When running inside Docker Compose, host is 'db'. For local development outside Docker, use 'localhost'.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledgerforge_db

# Complete Database URL (Used by SQLAlchemy / database engine)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ledgerforge_db
